---
import { SEO } from "astro-seo";

interface Props {
	title: string;
}

const { title } = Astro.props;
console.log(Astro.request.url);

---

<!doctype html>
<html lang="es">
	<head>
		<link rel="sitemap" href="/sitemap-index.xml" />
		<SEO
			title="Cerrajeros 24 HORAS"
			description="Somos Cerrajeros 24 horas en Barcelona líderes en el mercado de cerrajería, ofrecemos servicios de: Aperturas URGENTE de puertas, instalación y venta de cerraduras"
			canonical={Astro.site}
			openGraph={{
				basic: {
					title: "Cerrajeros 24 HORAS Barcelona",
					type: "website",
					image: "/logo.webp",
					url: Astro.site,
				}
			}}
		/>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="keywords" content="cerrajero, cerrajero 24 horas, estropeo la cerradura, llave por dentro, cerrajero barcelona, se me olvido por dentro la llave, se me partio la llave, se me rompio la llave" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
