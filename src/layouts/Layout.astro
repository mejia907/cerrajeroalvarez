---
import { SEO } from "astro-seo";
import GoogleAnalytics from "../components/common/GoogleAnalytics.astro";
import AOS from "../components/common/AOS.astro";
---

<!doctype html>
<html lang="es">
	<head>
		<GoogleAnalytics />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<SEO
			title="Cerrajero urgente Barcelona | Apertura de puertas, cambio de cerraduras"
			description="Cerrajero profesional Barcelona disponible 24h. Ofrecemos servicios rápidos y eficaces en toda la ciudad. ¡Contáctanos para emergencias!"
			charset="utf-8"
			openGraph={{
				basic: {
					title:
						"Cerrajero urgente barcelona. Apertura de puertas, cambio de cerraduras, cerrajeria 24 horas",
					type: "website",
					image: "https://cerrajeroluis24horas.com/logo.webp",
					url: Astro.site,
				},
				optional: {
					locale: "es-ES",
					description:
						"Cerrajero urgente Barcelona, servicios 24 horas, apertura de puertas, cambio de cerraduras y más.",
					siteName:
						"Cerrajeros 24 servicio puntual. Cerrajero urgente Barcelona",
				},
			}}
		/>
		<script is:inline type="application/ld+json">
			{
				"@context": "http://schema.org",
				"@type": "LocalBusiness",
				"name": "Cerrajero urgente Barcelona 24h",
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "Carrer de Cristóbal de Moura, 229",
					"addressLocality": "Barcelona",
					"addressRegion": "Cataluña",
					"postalCode": "08001",
					"addressCountry": "ES"
				},
				"telephone": "+34 624 463 373",
				"url": "https://cerrajeroluis24horas.com",
				"sameAs": ["https://www.instagram.com/cerrajero_24_horas"],
				"openingHours": "Mo-Su 00:00-23:59",
				"description": "Cerrajero urgente Barcelona, servicios 24h, apertura de puertas, cambio de cerraduras y más."
			}
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<AOS />
	</head>
	<body>
		<slot />
	</body>
</html>
