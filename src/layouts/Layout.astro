---
import { SEO } from "astro-seo";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<SEO
			title="Cerrajeros 24 HORAS"
			description="Somos Cerrajeros 24 horas en Barcelona líderes en el mercado de cerrajería, ofrecemos servicios de: Aperturas URGENTE de puertas, instalación y venta de cerraduras"
		/>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
