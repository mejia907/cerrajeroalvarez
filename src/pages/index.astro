---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import { Slide } from "../components/Slide";
import Company from "../components/Company.astro";
import Services from "../components/Services.astro";
import Brands from "../components/Brands.astro";
import Clients from "../components/Clients.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Whatsapp from "../components/common/Whatsapp.astro";

/// Lista de imagenes para el slider [public/slides]
const slides = [
	{
		image: "/slides/1.webp",
		alt: "Cerrajero Urgente Badalona",
	},
	{
		image: "/slides/2.webp",
		alt: "Cerrajero urgente Barcelona",
	},
	{
		image: "/slides/3.webp",
		alt: "Cerrajero urgente Santa Coloma de Gramanet",
	},
	{
		image: "/slides/4.webp",
		alt: "Cerrajero urgente El Poblenou",
	},
	{
		image: "/slides/5.webp",
		alt: "Cerrajero urgente Terrassa",
	},
	{
		image: "/slides/6.webp",
		alt: "Cerrajero Urgente Sabadell",
	},
	{
		image: "/slides/7.webp",
		alt: "Cerrajero urgente Sant Boi de Llobregat",
	},
];
---

<Layout title="Cerrajero 24h - Servicio puntual">
	<main class="bg-transparent w-full">
		<Header />
		<Hero />
		<Slide
			slides={slides}
			withImage="2xl:w-[17rem] lg:w-[20rem] w-[9rem] max-w-[30rem]"
			heightImage="2xl:h-[15rem] lg:h-[15rem] h-[8rem] max-h-[20rem]"
			client:load
		/>
		<Company />
		<Services />
		<Brands />
		<Clients />
		<Contact />
		<Footer />

		<!-- Whatsapp -->
		<Whatsapp />
		<!-- Icono llamar solo en modo mobile -->
		<button
			class="fixed bottom-0 left-1/2 transform -translate-x-1/2 bg-gradient-to-tl from-amber-500 to-yellow-400 hover:bg-yellow-600 text-xl font-semibold text-white px-4 py-3 items-center w-full flex md:hidden text-center justify-center z-20"
			onclick="window.location.href = 'tel:624463373';"
		>
			<Icon name="line-md:phone-call-loop" class="size-8 mr-2" />
			<span>Llamar ahora</span>
		</button>
</Layout>