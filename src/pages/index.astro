---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import { Slide } from "../components/Slide";
import Company from "../components/Company.astro";
import Services from "../components/Services.astro";
import Clients from "../components/Clients.astro";

const slides = [
	{
		image: "/slides/1.webp",
	},
	{
		image: "/slides/2.webp",
	},
	{
		image: "/slides/3.webp",
	},
	{
		image: "/slides/4.webp",
	},
	{
		image: "/slides/5.webp",
	},
];
---

<Layout title="Cerrajero 24h - Servicio puntual">
	<main class="z-50 bg-transparent py-6 px-10 lg:px-16 2xl:px-32">
		<Header />
		<Hero />
		<Slide
			slides={slides}
			heightImage="2xl:h-[16rem]  lg:h-[15rem] md:h-[10rem]"
			client:load
		/>
		<Company />
		<Services />
		<Clients />
	</main>
</Layout>
