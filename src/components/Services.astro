---
import { Icon } from "astro-icon/components";

import TitleSection from "./common/TitleSection.astro";

/// Lista de servicios
const itemsServices = [
  [
    {
      icon: "mdi:alarm-light",
      title: "Instalación de alarmas de seguridad",
      description:
        "Realizamos instalación alarmas de seguridad para su casa y así cuentes con la seguridad más avanzada. Esta siempre conectada a una central receptora que garantice una respuesta rápida y eficaz en caso de salto de alarma o emergencia, así como la intervención policial en caso de intrusión confirmada. Nos encargamos de instalar tu alarma en casa y del mantenimiento, garantizando así su óptimo funcionamiento.",
    },
    {
      icon: "mdi:blinds-horizontal",
      title: "Instalación de persianas metálicas",
      description:
        "Realizamos apertura de urgencia, instalación desde cero y reparación tanto mecánica como por desgaste para la persiana de su local, recuperando la funcionalidad, devolviendo la privacidad y seguridad.",
    },
    {
      icon: "mdi:blinds-horizontal-closed",
      title: "Instalación de persianas motorizadas para tu hogar",
      description:
        "Realizamos instalación y reparación de persianas motorizadas, gracias a la avanzada tecnología de radio integrada en los motores, tienes el poder de abrir y cerrar tus persianas con facilidad desde el confort de tu mando a distancia.",
    },
    {
      icon: "solar:shield-bold",
      title: "Instalación de escudo protector magnético",
      description:
        "Realizamos instalación de escudo protector magnetico para su puerta, aportando una protección adicional al cilindro contra ataques vandálicos como la rotura del puente o la extracción. El escudo se desbloquea a través de un llavero magnético con combinación; Incluye 2 llaves magnéticas y montaje sin tornilleria pasante.",
    },
  ],
  [
    {
      icon: "wpf:privacy",
      title: "Cambio de cerraduras",
      description:
        "Realizamos cambios de Cerraduras sencillas, cerraduras de alta y mediana seguridad. Ya sea por razones de seguridad o actualización.",
    },
    {
      icon: "wpf:maintenance",
      title: "Reparación Cerraduras",
      description:
        "Ofrecemos servicios de reparación de cerraduras con soluciones rápidas y eficientes. Restauración de funcionalidad y seguridad de sus cerraduras.",
    },
    {
      icon: "cbi:panel-front-door-locked",
      title: "Suministro e Instalación de cerraduras fichet",
      description:
        "Las cerraduras Fichet, conocidas por su calidad y resistencia, garantizan una protección incomparable. Nuestros cerrajeros expertos le asesorarán sobre las mejores opciones adaptadas a sus necesidades específicas.",
    },
    {
      icon: "wpf:key-security",
      title: "Apertura de puertas",
      description:
        "Con experiencia en todo tipo de cerraduras, proporcionamos soluciones confiables para recuperar el acceso a su espacio de manera eficiente.",
    },
    {
      icon: "solar:user-speak-linear",
      title: "Asesoría gratuita",
      description:
        "Asesoría gratuita en seguridad para tu hogar, oficinas y locales.",
    },
  ],
];
---

<section class="scroll-mt-16 pt-10 mx-auto bg-gray-400/10" id="services">
  <div class="px-4 py-8 mx-auto lg:px-8 lg:py-10  max-w-7xl ">
    <div class="mb-10 md:mx-auto sm:text-center md:mb-12 max-w-4xl">
      <TitleSection title="Servicios" />
      <span class="text-xl">
        <span class="font-bold">Cerrajeros 24 horas</span>
        brinda diferentes servicios para tu hogar, oficinas y locales
      </span>
    </div>
    <div class="grid mx-auto space-y-6 md:grid-cols-2 md:space-y-0">
      {
        itemsServices.map((subitems) => (
          <div class="space-y-8">
            {subitems.map(({ icon, title, description }) => (
              <div class="flex flex-row max-w-xl">
                <div class="mb-4 mr-4">
                  <div class="text-white flex items-center justify-center md:w-12 w-8 md:h-12 h-8 rounded-full bg-primary">
                    {icon && <Icon name={icon} class="md:w-6 w-4 md:h-6 h-4" />}
                  </div>
                </div>
                <div>
                  <h3 class="mb-3 text-lg md:text-xl font-bold">{title}</h3>
                  <p class="text-black text-lg text-justify">{description}</p>
                </div>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
