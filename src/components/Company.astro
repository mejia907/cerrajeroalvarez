---
import { Icon } from "astro-icon/components";
import Button from "./common/Button.astro";
import TitleSection from "./common/TitleSection.astro";

const itemsLocation = [
  {
    icon: "mdi:location",
    title: "Barcelona",
  },
  {
    icon: "mdi:location",
    title: "Terrassa",
  },
  {
    icon: "mdi:location",
    title: "Badalona",
  },
  {
    icon: "mdi:location",
    title: "Sabadell",
  },
  {
    icon: "mdi:location",
    title: "Santa Coloma de Gramanet",
  },
  {
    icon: "mdi:location",
    title: "Sant Cugat del Vallés",
  },
  {
    icon: "mdi:location",
    title: "Cornellá de Llobregat",
  },
  {
    icon: "mdi:location",
    title: "Sant Boi de Llobregat",
  },
  {
    icon: "mdi:location",
    title: "Mataró",
  },
  {
    icon: "mdi:location",
    title: "Castelldefels",
  },
  {
    icon: "mdi:location",
    title: "El Poblenou",
  },
  {
    icon: "mdi:location",
    title: "L'Hospitalet de Llobregat",
  },
];
---

<section class="scroll-mt-16 pt-10 max-w-7xl mx-auto" id="home">
  <div class="px-4 py-8 mx-auto max-w-full lg:px-8 lg:py-10">
    <div class="md:mx-auto sm:text-center max-w-8xl">
      <TitleSection title="Cerrajeros 24 HORAS en Barcelona" />
      <div
        class="mx-auto space-y-6 md:grid-cols-2 md:space-y-0 text-lg text-justify"
      >
        Somos Cerrajeros 24 horas en Barcelona líderes en el mercado de
        cerrajería, ofrecemos servicios de: Aperturas URGENTE de puertas,
        instalación y venta de cerraduras, reparación de cerraduras, copia de llaves, instalación
        y venta de Alarmas para puerta, bombines ó cilindros, candados, escudos
        de seguridad y más elementos de seguridad.
        <p class="mt-5">
          Prestamos nuestro servicio en todo Barcelona y sus diferentes
          localidades:
        </p>
        <div class="md:py-5 py-0 grid">
          <ul class="list-none list-inside grid md:grid-cols-2">
            {
              itemsLocation.map(({ icon, title }) => (
                <li class="mt-2">
                  {" "}
                  <Icon name={icon} class="size-6 mr-2 text-red-600 inline-block align-middle" /> 
                  <span class="inline-block align-middle ">{title}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="mt-3 grid md:flex md:grid-cols-1 mb-3">
          <div class="md:grid-cols-2 mr-2 md:text-left text-center">
            <p>Contáctenos en la línea única nacional:</p>
            <span class="font-bold text-2xl">624 46 33 73</span>
          </div>
          <div class="my-2 flex justify-center items-center text-center">
            <Button text="Llámanos" onClick="tel:624463373" animate={true} />
          </div>
        </div>
        <p class="mt-5">
          Ofrecemos servicios de cerrajeros a domicilio, <span
            class="font-bold text-xl">disponible las 24 horas</span
          >, con atención rápida y eficiente.
        </p>
      </div>
    </div>
  </div>
</section>
