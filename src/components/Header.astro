---
import { Image } from 'astro:assets';
---

<header class="flex items-center relative justify-between">
  <div class="text-black text-2xl font-bold">
    <a href="/">
      <Image src="/logo.webp" alt="Logo" width={10} height={10} alt="Cerrajero 24h" class="w-[50%] 2xl:w-[35%] lg:w-[36%]" loading={"eager"} />
    </a>
  </div>
  <button
    id="hamburger"
    class="md:hidden text-black absolute right-0 text-xl"
  >
  <!-- class="w-1/2 md:w-1/5 2xl:w-[18%] lg:w-1/3" -->
    ☰
  </button>
  <ul class="hidden md:flex gap-16 text-black mt-2 mr-20 text-lg font-semibold " id="menu">
    <li><a href="/about" class="hover:text-gray-400">Inicio</a></li>
    <li><a href="/services" class="hover:text-gray-400">Servicios</a></li>
    <li><a href="/clients" class="hover:text-gray-400">Clientes</a></li>
    <li><a href="/contacts" class="hover:text-gray-400">Contacto</a></li>
  </ul>
</header>