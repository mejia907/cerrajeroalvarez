---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const itemsMenu = [
  { name: "Inicio", href: "#home" },
  { name: "Servicios", href: "#services" },
  { name: "Clientes", href: "#clients" },
  { name: "Contacto", href: "#contact" },
];

const linkClass =
  "relative text-black text-base font-medium hover:text-black transition-colors after:absolute after:bottom-[-2px] after:left-0 after:h-[2px] after:w-full after:bg-primary after:scale-x-0 after:hover:scale-x-100 after:transition-transform after:duration-300 after:origin-center";
---

<header class="sticky top-0 z-50 w-full bg-white border-b border-gray-100">
  <div
    class="max-w-7xl mx-auto px-6 md:px-10 h-16 flex items-center justify-between"
  >
    <a
      href="/"
      aria-label="Inicio"
    >
      <Image
        src="/logo.webp"
        width={120}
        height={40}
        alt="Cerrajero urgente barcelona"
        class="h-10 w-auto"
        loading="eager"
      />
    </a>

    <!-- Navegación desktop -->
    <nav
      class="hidden md:flex items-center gap-8"
      aria-label="Menú principal"
    >
      <a
        href="#home"
        class={linkClass}
        >Inicio</a
      >
      <a
        href="#services"
        class={linkClass}
        >Servicios</a
      >
      <a
        href="#clients"
        class={linkClass}
        >Clientes</a
      >
      <a
        href="#contact"
        class={linkClass}
        >Contacto</a
      >
    </nav>

    <!-- Botón hamburguesa -->
    <button
      id="menuToggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobileMenu"
      class="md:hidden text-black p-1"
    >
      <Icon
        name="mdi:menu"
        class="size-7"
        id="iconOpen"
      />
      <Icon
        name="mdi:close"
        class="size-7 hidden"
        id="iconClose"
      />
    </button>
  </div>

  <!-- Menú mobile -->
  <div
    id="mobileMenu"
    class="hidden md:hidden border-t border-gray-100 bg-white"
    aria-hidden="true"
  >
    <nav
      class="flex flex-col px-6 py-4 gap-1"
      aria-label="Menú mobile"
    >
      <a
        href="#home"
        class="mobile-link py-3 text-base text-gray-700 hover:text-black border-b border-gray-50 transition-colors"
        >Inicio</a
      >
      <a
        href="#services"
        class="mobile-link py-3 text-base text-gray-700 hover:text-black border-b border-gray-50 transition-colors"
        >Servicios</a
      >
      <a
        href="#clients"
        class="mobile-link py-3 text-base text-gray-700 hover:text-black border-b border-gray-50 transition-colors"
        >Clientes</a
      >
      <a
        href="#contact"
        class="mobile-link py-3 text-base text-gray-700 hover:text-black last:border-0 transition-colors"
        >Contacto</a
      >
    </nav>
  </div>
</header>

<script>
  import AOS from "aos";
  AOS.init();
  const toggle = document.getElementById("menuToggle")!;
  const menu = document.getElementById("mobileMenu")!;
  const iconOpen = document.getElementById("iconOpen")!;
  const iconClose = document.getElementById("iconClose")!;
  const mobileLinks = document.querySelectorAll<HTMLElement>(".mobile-link");

  function toggleMenu(force?: boolean) {
    const isOpen = force ?? menu.classList.contains("hidden");
    menu.classList.toggle("hidden", !isOpen);
    menu.setAttribute("aria-hidden", String(!isOpen));
    toggle.setAttribute("aria-expanded", String(isOpen));
    iconOpen.classList.toggle("hidden", isOpen);
    iconClose.classList.toggle("hidden", !isOpen);
  }

  toggle.addEventListener("click", () => toggleMenu());

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => toggleMenu(false));
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768) toggleMenu(false);
  });
</script>
