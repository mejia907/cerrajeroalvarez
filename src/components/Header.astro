---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

const itemsMenu = [
  {
    name: "Inicio",
    href: "#home",
  },
  {
    name: "Servicios",
    href: "#services",
  },
  {
    name: "Clientes",
    href: "#clients",
  },
  {
    name: "Contacto",
    href: "#contact",
  },
];
---

<header
  class="flex top-0 z-50 bg-white justify-center sticky pt-2 items-center "
  data-aos="fade-down" data-aos-offset="500" data-aos-duration="500"
>
<div class="flex items-center max-w-7xl md:mx-10 mx-8">
  <div class="text-black text-2xl font-bold">
    <a href="/">
      <Image
        src="/logo.webp"
        width={10}
        height={10}
        alt="Cerrajero urgente barcelona"
        class="w-[50%] 2xl:w-[25%] lg:w-[25%]"
        loading={"eager"}
      />
    </a>
  </div>
  <div class="flex justify-center items-center">
    <button
      id="openMenu"
      aria-label="Open Menu"
      class="md:hidden text-black absolute text-xl"
    >
      <Icon name="mdi:menu" class="size-8" />
    </button>
    <button id="closeMenu" aria-label="Close Menu" class="hidden text-black absolute text-xl">
      <Icon name="mdi:close" class="size-8" />
    </button>
  </div>
  <div class="hidden md:flex md:justify-center md:tems-center" id="menu">
    <ul
      class="fixed bg-white w-[80%] h-[100vh] xl:h-[10vh] md:w-[40%] pt-10 xl:w-full left-0 top-0 xl:static flex-1 flex-col xl:flex-row items-center gap-10 text-gray-500 text-xl md:text-lg transition-all duration-500 z-50 lg:justify-end flex"
    >
      {
        itemsMenu.map((item) => (
          <li>
            <a
              href={item.href}
              class="relative text-xl w-fit block after:block after:content-[''] after:absolute after:h-[3px] after:bg-primary after:w-full after:scale-x-0 after:hover:scale-x-100 after:transition after:duration-300 after:origin-center text-black"
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
</header>

<script>
  import AOS from "aos";
  AOS.init();

  document.addEventListener("DOMContentLoaded", () => {
    const openMenu = document.getElementById("openMenu");
    const menu = document.getElementById("menu");
    const close = document.getElementById("closeMenu");
    const optionsMenu = document.querySelectorAll("#menu li a");

    function closeMenu() {
      menu?.classList.toggle("hidden");
    }

    openMenu?.addEventListener("click", () => {
      close?.classList.toggle("hidden");
      openMenu?.classList.toggle("hidden");
      closeMenu();
    });

    close?.addEventListener("click", () => {
      openMenu?.classList.toggle("hidden");
      close?.classList.toggle("hidden");
      closeMenu();
    });

    optionsMenu.forEach((option) => {
      option.addEventListener("click", () => {
        if (window.innerWidth <= 1250) {
          close?.classList.toggle("hidden");
          openMenu?.classList.toggle("hidden");
          closeMenu();
        }
      });
    });
  });
</script>
