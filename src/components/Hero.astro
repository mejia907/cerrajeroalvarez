---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Button from "./common/Button.astro";
---

<section
  class="mt-4 lg:mt-0 2xl:mt-0 w-auto flex bg-white h-screen flex-col items-center bg-no-repeat bg-cover"
  style="background-image: url('/background.png')"
>
  <Image
    src="/home.webp"
    width={10}
    height={10}
    alt="Cerrajero 24h"
    class="md:w-[23%] lg:w-[23%] w-[70%] z-0"
    loading={"eager"}
    data-aos="zoom-out"
    data-aos-duration="2000"
  />
  <div
    class="md:w-3/5 w-[90%] h-[72%] md:h-[33%] lg:h-[50%] 2xl:h-[52%] bg-white top-[44%]  border-2 border-primary rounded-lg z-10 flex flex-col items-center absolute" data-aos="zoom-in" data-aos-duration="1000"
  >
    <div
      class="lg:pt-1 2xl:pt-4 pt-2 px-2 md:px-0 2xl:inline-flex md:inline-flex lg:inline-flex"
    >
      <div class="text-center items-center justify-center flex">
        <span
          class="text-black font-bold md:text-7xl lg:text-5xl text-5xl 2xl:text-7xl"
        >
          URGENCIAS
        </span>
      </div>
      <div class="text-center items-center justify-center flex">
        <Icon name="mdi:hours-24" class="size-20 mx-2 text-amber-500" />
      </div>
      <div class="text-center items-center justify-center flex">
        <span
          class="text-black font-bold md:text-7xl lg:text-5xl text-5xl 2xl:text-7xl"
        >
          HORAS
        </span>
      </div>
    </div>
    <div class="text-center items-center justify-center flex">
      <h1
        class="text-2xl lg:text-3xl 2xl:text-5xl text-black w-full font-bold mt-1 2xl:mt-5 lg:mt-0 px-4 md:px-0"
      >
        Abrir y cambiar cerraduras
      </h1>
    </div>
    <div class="text-center items-center justify-center flex">
      <h2
        class="text-black md:mt-5 mt-2 lg:mt-1 text-center md:text-left md:text-2xl text-base lg:text-xl px-2 md:px-0"
      >
        Comunicate con nosotros y te ayudamos a solucionar tus problemas
      </h2>
    </div>
    <span
      class="text-black md:mt-5 2xl:mt-5 mt-5 lg:mt-1 text-center md:text-left text-5xl lg:text-5xl 2xl:text-6xl px-2 font-bold md:flex hidden"
    >
      639 98 08 62 / 624 46 33 73
    </span>
    <div
      class="text-black mt-2 text-center md:text-left text-4xl 2xl:text-5xl px-2 font-bold md:hidden flex flex-col"
    >
      <p>639 98 08 62</p>
      <p>624 46 33 73</p>
    </div>
    <div
      class="px-2 md:px-0 2xl:inline-flex md:inline-flex lg:inline-flex mt-4"
    >
      <Button text="Llamar ahora" onClick="tel:639980862" />
    </div>
  </div>
</section>
