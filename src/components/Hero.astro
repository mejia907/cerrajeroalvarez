---
import { Image } from "astro:assets";
import Button from "./common/Button.astro";
---

<section
  class="relative w-full min-h-screen flex flex-col items-center bg-white bg-no-repeat bg-cover overflow-hidden"
  style="background-image: url('/background.png')"
>
  <!-- Contenedor de imagen (solo mitad visible) -->
  <div class="w-full flex justify-center pt-10 pb-20">
    <Image
      src="/home.webp"
      width={500}
      height={500}
      alt="Cerrajero urgente 24h"
      class="w-[70%] sm:w-[50%] md:w-[35%] lg:w-[25%] object-cover"
      loading="eager"
      data-aos="zoom-out"
      data-aos-duration="2000"
    />
  </div>

  <!-- Card superpuesta -->
  <div
    class="relative -mt-32 sm:-mt-40 md:-mt-48 w-[90%] max-w-3xl bg-white border-2 border-primary rounded-xl shadow-xl flex flex-col items-center text-center p-6 md:p-8 z-10"
    data-aos="zoom-in"
    data-aos-duration="1000"
  >
    <h1 class="text-black font-bold text-3xl sm:text-5xl lg:text-6xl">
      CERRAJERO URGENTE
    </h1>

    <h2 class="text-black font-bold text-xl sm:text-2xl lg:text-3xl mt-2">
      Abrir y cambiar cerraduras
    </h2>

    <p class="text-black text-base sm:text-lg md:text-xl mt-3 max-w-2xl">
      Comunícate con nosotros y te ayudamos a solucionar tus problemas
    </p>

    <span class="text-black font-bold text-3xl sm:text-4xl lg:text-5xl mt-4">
      624 46 33 73
    </span>

    <div class="mt-5">
      <Button text="Llamar ahora" onClick="tel:624463373" />
    </div>
  </div>
</section>