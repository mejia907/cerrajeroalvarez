---
import { Icon } from "astro-icon/components";
---

<section class="mt-14 2xl:mt-20 w-auto flex bg-white rounded-2xl">
  <div
    class="rounded-2xl flex flex-col items-center lg:items-start 2xl:items-start w-full 2xl:w-8/12 md:w-9/12"
  >
    <div
      class="rounded-2xl py-1 px-2 md:px-0 2xl:inline-flex md:inline-flex lg:inline-flex text-center items-center justify-center"
    >
      <span class="text-black font-bold 2xl:text-6xl text-5xl">
        URGENCIAS
      </span>
      <div class="text-center items-center justify-center flex">
        <Icon name="mdi:hours-24" class="size-20 mx-2 text-amber-500" />
      </div>
      <span class="text-black font-bold 2xl:text-6xl text-5xl">HORAS</span>
    </div>
    <div class="flex flex-col items-left w-[25rem] md:w-full">
      <h1
        class="text-4xl lg:text-4xl 2xl:text-5xl text-black w-full text-center md:text-left font-bold mt-10 px-4 md:px-0"
      >
        Abrir y cambiar cerraduras
      </h1>
    </div>

    <h2
      class="text-black mt-5 text-center md:text-left text-2xl lg:text-xl px-4 md:px-0"
    >
      Comunicate con nosotros y te ayudamos a solucionar tus problemas
    </h2>
    <div
      class="flex flex-col flex-nowrap gap-4 m-auto max-w-xs sm:flex-row sm:justify-center lg:justify-start lg:m-0 2xl:pt-16 pt-2"
    >
      <button
        class="bg-gradient-to-tl from-amber-500 to-yellow-400 hover:bg-yellow-600 text-xl font-semibold text-white px-4 py-2 rounded-xl mt-3 flex items-center gap-2" onclick="window.location.href = 'tel:639980862';"
      >
        <Icon name="line-md:phone-call-loop" class="size-8" />
        <span>Llamar ahora</span>
      </button>
    </div>
    <span
      class="text-black mt-5 text-center md:text-left text-4xl 2xl:text-5xl px-2 font-bold md:flex hidden"
    >
      639 98 08 62 / 624 46 33 73
    </span>
    <div
      class="text-black mt-5 text-center md:text-left text-4xl 2xl:text-5xl px-2 font-bold md:hidden flex flex-col"
    >
      <p>639 98 08 62</p> 
      <p>624 46 33 73</p>
    </div>
  </div>
  <div class="hidden md:inline-flex text-center items-center justify-center">
    <img
      src="/logo_home.webp"
      alt="Cerrajero 24h"
      class="w-10/12 2xl:w-11/12 2xl:m-1"
    />
  </div>
</section>
