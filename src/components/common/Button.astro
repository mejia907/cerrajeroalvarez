---
import { Icon } from "astro-icon/components";

interface Props {
  text: string;
  onClick: string;
  animate?: boolean;
}


const { text, onClick, animate } = Astro.props;
---

<button
  class="bg-gradient-to-tl from-amber-500 to-yellow-400 hover:bg-yellow-600 text-xl font-semibold text-white px-4 py-2 rounded-xl flex items-center md:w-full justify-center"
  onclick={`window.location.href = '${onClick}'`} data-aos={animate ? "zoom-in" : ""}
  > 
  <Icon name="line-md:phone-call-loop" class="size-8" />
  <span class="ml-2 md:ml-4">{text}</span>
</button>